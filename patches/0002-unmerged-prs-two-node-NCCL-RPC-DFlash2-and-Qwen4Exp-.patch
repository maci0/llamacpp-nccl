+export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-enp1s0f1np1}"
+export NCCL_IB_HCA="${NCCL_IB_HCA:-rocep1s0f1}"
+export NCCL_DEBUG="${NCCL_DEBUG:-INFO}"
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
+
+exec "${BIN}/llama-cli" \
+    -m "${GGUF}" \
+    --rpc "${REMOTE}" \
+    --split-mode tensor \
+    -ngl 999 \
+    -fa on \
+    -ctk f16 -ctv f16 \
+    --ctx-size "${CTX:-2048}" \
+    -n "${N_PREDICT:-32}" \
+    --no-warmup \
+    -p "${PROMPT}" \
+    "$@"
