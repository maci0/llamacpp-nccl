From 15e3d5678db69caa854ab492438d662b864150e0 Mon Sep 17 00:00:00 2001
From: "Marcel W. Wysocki" <maci.stgn@gmail.com>
Date: Sun, 30 Aug 2026 13:57:36 +0800
Subject: [PATCH] ggml-cuda: optimize single-token MMVQ dispatch for RDNA3
 architecture

(cherry picked from commit 41686b31d052c192978f2a918f66482edae26f6f)
---
 ggml/src/ggml-cuda/mmvq.cu | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 6305230b1..398107305 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1180,6 +1180,17 @@ static void mul_mat_vec_q_switch_ncols_dst(
                     stream);
             };
 
+            // Fast-path for RDNA3 single-token vector multiplication
+            if (table_id == MMVQ_PARAMETERS_RDNA3_0 && !has_ids && nchannels_dst == 1) {
+                const std::pair<dim3, dim3> dims = calc_launch_params<type>(1, nrows_x, 1, 1, warp_size, table_id, false, false);
+                mul_mat_vec_q_switch_fusion<type, 1, false, false>(
+                    vx, vy, ids, fusion, dst, ncols_x, nchannels_y_fd, stride_row_x, stride_col_y, stride_col_dst,
+                    channel_ratio_fd, stride_channel_x, stride_channel_y, stride_channel_dst, sample_ratio_fd,
+                    stride_sample_x, stride_sample_y, stride_sample_dst, dims.first, dims.second, 0, ids_stride,
+                    stream);
+                break;
+            }
+
             if (should_use_small_k(c_ncols_dst)) {
                 launch(std::true_type{},  std::false_type{});
             } else if (should_halve_iters()) {
-- 
